{
  "manifest_version": 3,
  "name": "Omni Theme",
  "version": "2.0.0",
  "description": "Глобальная тема The Omniscience через CSS-цветовую арифметику",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Omni Theme"
  },
  "omniscience": {
    "preloads": [
      {
        "matches": ["<all_urls>"],
        "css": ["base.css"],
        "js": ["bridge.js", "content.js"]
      }
    ],
    "targets": {
      "webapps": true,
      "componentapps": true,
      "extensions": true,
      "shell": true,
      "devtools": false
    }
  }
}