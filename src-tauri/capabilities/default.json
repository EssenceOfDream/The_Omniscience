{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the desktop workspace windows",
  "windows": ["desktop", "panel", "controls", "overview", "window-settings", "component-*"],
  "permissions": [
    "trusted-app-commands",
    "extension-storage",
    "core:default",
    "core:webview:allow-internal-toggle-devtools",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:default",
    "opener:allow-open-path"
  ]
}
