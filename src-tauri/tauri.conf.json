{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The_Omniscience",
  "version": "13.4.1",
  "identifier": "com.essenceofdream.omniscience",
  "build": {
    "beforeDevCommand": "npm run build:project && npm run preview",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "desktop",
        "title": "The Omniscience",
        "url": "index.html",
        "devtools": true,
        "width": 1180,
        "height": 800,
        "minWidth": 700,
        "minHeight": 600,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "../icon.ico"
    ]
  }
}
